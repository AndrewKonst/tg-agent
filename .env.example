# Copy this file to .env and fill in real values.
# .env is git-ignored; never commit real credentials.
# Real environment variables always take precedence over this file.

# --- Required ---

# Telegram bot token from @BotFather.
TELEGRAM_BOT_TOKEN=123456789:AAExampleTokenReplaceMe

# API key for the LLM provider selected below.
# Not required when LLM_PROVIDER=ollama.
LLM_API_KEY=sk-replace-me

# Model id, as the provider names it. Must match LLM_PROVIDER.
#   openai    -> gpt-4o-mini, gpt-4o, ...
#   anthropic -> claude-sonnet-4-5, claude-haiku-4-5, ...
#   ollama    -> llama3.2, qwen2.5, ...
LLM_MODEL=gpt-4o-mini

# --- Optional (defaults shown) ---

# Which backend to talk to: openai | anthropic | ollama
LLM_PROVIDER=openai

# Hard deadline for a whole agentic run — every step together, in milliseconds.
LLM_TIMEOUT_MS=30000

# Deadline for one call to the model inside a run, in milliseconds.
# A local model loading a 14B checkpoint on the first request needs room here.
# LLM_CALL_TIMEOUT_MS=60000

# How many times one model call is retried after a transient failure
# (network, HTTP 429, HTTP 5xx). Counted separately from AGENT_MAX_STEPS.
# LLM_MAX_ATTEMPTS=3

# Override the provider endpoint. Leave unset for the provider's own API.
# Useful for OpenAI-compatible gateways: Azure OpenAI, OpenRouter, LiteLLM, vLLM.
# LLM_BASE_URL=http://localhost:11434

# Instructions given to the agent on every request.
# SYSTEM_PROMPT=You are a helpful assistant answering inside a Telegram chat.

# Loop guard: how many times the model may be asked for one user message before
# the run is cut short. Each step is one LLM call plus any tools it requested.
# AGENT_MAX_STEPS=8

# Where conversation history lives: sqlite | memory
# sqlite keeps a chat across restarts; memory forgets everything when the bot stops.
# CONVERSATION_STORE=sqlite

# SQLite file for the history. Created on first run; the directory is git-ignored.
# CONVERSATION_DB_PATH=data/conversations.db

# Roughly how much of a chat's history is replayed into each run, in characters.
# Older turns are dropped whole, so a tool result is never separated from its call.
# CONVERSATION_MAX_CHARS=12000

# --- Shell access (the exec tool) ---

# Chat ids allowed to run shell commands, comma-separated. Send /whoami to the bot
# to learn yours. Anyone can find a bot on Telegram, so this list is the only thing
# between a stranger and a shell — leave it empty and exec stays disabled for all.
# OWNER_CHAT_IDS=

# Where commands run: docker | host | off
#   docker — inside a container with capped memory, CPU and processes (the default)
#   host   — directly on this machine, with no isolation whatsoever
#   off    — no shell at all
# EXEC_SANDBOX=docker

# Hard limit on a single command, in milliseconds. It is killed with its children.
# EXEC_TIMEOUT_MS=30000

# How much of a command's output reaches the model, in characters.
# EXEC_OUTPUT_LIMIT=4000

# Sandbox image and container names. The image is built from sandbox/Dockerfile
# on first use.
# EXEC_IMAGE=tg-agent-sandbox:1
# EXEC_CONTAINER=tg-agent-sandbox

# Working directory for EXEC_SANDBOX=host. Ignored for docker, which uses /work.
# EXEC_WORKDIR=data/workspace

# Repository whose .git is mounted read-only at /project/.git, so the agent can read
# commit history. Only .git is exposed — never the working tree, where .env lives.
# PROJECT_GIT_DIR=.git

# Directory of Markdown skill files. Each needs '---' front matter with a
# 'description'; the description is what the model sees in its system prompt, and
# the body is fetched only when the model asks for that skill.
# SKILLS_DIR=skills
